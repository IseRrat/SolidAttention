find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(SOLID_OVERLAY "${CMAKE_BINARY_DIR}/generated/upstream")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/scripts/generate_adapter.py")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/generate_adapter.py"
    "${PROJECT_SOURCE_DIR}/third_party/llama.cpp/src" "${SOLID_OVERLAY}"
    RESULT_VARIABLE SOLID_OVERLAY_STATUS ERROR_VARIABLE SOLID_OVERLAY_ERROR)
if(NOT SOLID_OVERLAY_STATUS EQUAL 0)
    message(FATAL_ERROR "Upstream adapter generation failed: ${SOLID_OVERLAY_ERROR}")
endif()
get_target_property(SOLID_LLAMA_SOURCES llama SOURCES)
get_target_property(SOLID_LLAMA_SOURCE_DIR llama SOURCE_DIR)
set(SOLID_ADAPTED_SOURCES "")
foreach(SOLID_SOURCE IN LISTS SOLID_LLAMA_SOURCES)
    if(SOLID_SOURCE STREQUAL "llama-graph.cpp" OR SOLID_SOURCE STREQUAL "llama-context.cpp")
        list(APPEND SOLID_ADAPTED_SOURCES "${SOLID_OVERLAY}/${SOLID_SOURCE}")
    elseif(IS_ABSOLUTE "${SOLID_SOURCE}")
        list(APPEND SOLID_ADAPTED_SOURCES "${SOLID_SOURCE}")
    else()
        list(APPEND SOLID_ADAPTED_SOURCES "${SOLID_LLAMA_SOURCE_DIR}/${SOLID_SOURCE}")
    endif()
endforeach()
set_property(TARGET llama PROPERTY SOURCES "${SOLID_ADAPTED_SOURCES}")
target_sources(llama PRIVATE "${PROJECT_SOURCE_DIR}/src/llama_adapter.cpp" "${PROJECT_SOURCE_DIR}/src/projection.cpp"
                            "${PROJECT_SOURCE_DIR}/src/ggml_prefetch.cpp" "${PROJECT_SOURCE_DIR}/src/device_ops.cpp")
set_source_files_properties("${SOLID_OVERLAY}/llama-graph.cpp" "${SOLID_OVERLAY}/llama-context.cpp"
    "${PROJECT_SOURCE_DIR}/src/llama_adapter.cpp" "${PROJECT_SOURCE_DIR}/src/projection.cpp"
    "${PROJECT_SOURCE_DIR}/src/ggml_prefetch.cpp" "${PROJECT_SOURCE_DIR}/src/device_ops.cpp"
    TARGET_DIRECTORY llama PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
target_include_directories(llama PRIVATE "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(llama PRIVATE solid_core)
if(SOLID_CUDA)
    enable_language(CUDA)
    find_package(CUDAToolkit REQUIRED)
    add_library(solid_cuda_selection STATIC "${PROJECT_SOURCE_DIR}/src/cuda/block_ranker.cu" "${PROJECT_SOURCE_DIR}/src/cuda/tiled_prefill.cu"
        "${PROJECT_SOURCE_DIR}/src/cuda/attention_events.cu")
    target_include_directories(solid_cuda_selection PUBLIC "${PROJECT_SOURCE_DIR}/include")
    target_include_directories(solid_cuda_selection PRIVATE "${PROJECT_SOURCE_DIR}/third_party/llama.cpp/ggml/src"
        "${PROJECT_SOURCE_DIR}/third_party/llama.cpp/ggml/include")
    target_link_libraries(solid_cuda_selection PUBLIC solid_core CUDA::cudart)
    get_target_property(SOLID_SELECTION_ARCHITECTURES ggml-cuda CUDA_ARCHITECTURES)
    set_target_properties(solid_cuda_selection PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON
        CUDA_ARCHITECTURES "${SOLID_SELECTION_ARCHITECTURES}")
    target_compile_options(solid_cuda_selection PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:--fmad=false>")
    target_link_libraries(llama PRIVATE solid_cuda_selection)
    target_compile_definitions(llama PRIVATE SOLID_HAVE_CUDA_SELECTION=1)
    get_target_property(SOLID_CUDA_SOURCES ggml-cuda SOURCES)
    get_target_property(SOLID_CUDA_SOURCE_DIR ggml-cuda SOURCE_DIR)
    set(SOLID_ADAPTED_CUDA "")
    foreach(SOLID_SOURCE IN LISTS SOLID_CUDA_SOURCES)
        get_filename_component(SOLID_SOURCE_NAME "${SOLID_SOURCE}" NAME)
        if(SOLID_SOURCE_NAME STREQUAL "ggml-cuda.cu")
            list(APPEND SOLID_ADAPTED_CUDA "${SOLID_OVERLAY}/ggml-cuda.cu")
        elseif(IS_ABSOLUTE "${SOLID_SOURCE}")
            list(APPEND SOLID_ADAPTED_CUDA "${SOLID_SOURCE}")
        else()
            list(APPEND SOLID_ADAPTED_CUDA "${SOLID_CUDA_SOURCE_DIR}/${SOLID_SOURCE}")
        endif()
    endforeach()
    set_property(TARGET ggml-cuda PROPERTY SOURCES "${SOLID_ADAPTED_CUDA}")
    target_include_directories(ggml-cuda PRIVATE "${PROJECT_SOURCE_DIR}/include" "${SOLID_CUDA_SOURCE_DIR}")
endif()
get_target_property(SOLID_GGML_SOURCES ggml-base SOURCES)
get_target_property(SOLID_GGML_DIR ggml-base SOURCE_DIR)
set(SOLID_ADAPTED_GGML "")
foreach(SOLID_SOURCE IN LISTS SOLID_GGML_SOURCES)
    if(SOLID_SOURCE STREQUAL "ggml-backend.cpp")
        list(APPEND SOLID_ADAPTED_GGML "${SOLID_OVERLAY}/ggml-backend.cpp")
    elseif(IS_ABSOLUTE "${SOLID_SOURCE}")
        list(APPEND SOLID_ADAPTED_GGML "${SOLID_SOURCE}")
    else()
        list(APPEND SOLID_ADAPTED_GGML "${SOLID_GGML_DIR}/${SOLID_SOURCE}")
    endif()
endforeach()
set_property(TARGET ggml-base PROPERTY SOURCES "${SOLID_ADAPTED_GGML}")
target_include_directories(ggml-base PRIVATE "${PROJECT_SOURCE_DIR}/include" "${SOLID_GGML_DIR}")
