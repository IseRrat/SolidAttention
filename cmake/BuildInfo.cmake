file(GLOB_RECURSE SOLID_BUILD_INPUTS CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}"
    "${PROJECT_SOURCE_DIR}/src/*.cpp" "${PROJECT_SOURCE_DIR}/include/*.hpp" "${PROJECT_SOURCE_DIR}/cmake/*")
list(APPEND SOLID_BUILD_INPUTS "CMakeLists.txt")
list(APPEND SOLID_BUILD_INPUTS "scripts/generate_adapter.py")
list(SORT SOLID_BUILD_INPUTS)
set(SOLID_BUILD_FILES_JSON "")
foreach(SOLID_INPUT IN LISTS SOLID_BUILD_INPUTS)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${SOLID_INPUT}")
    file(SHA256 "${PROJECT_SOURCE_DIR}/${SOLID_INPUT}" SOLID_INPUT_SHA)
    if(SOLID_BUILD_FILES_JSON)
        string(APPEND SOLID_BUILD_FILES_JSON ",")
    endif()
    string(APPEND SOLID_BUILD_FILES_JSON "\"${SOLID_INPUT}\":\"${SOLID_INPUT_SHA}\"")
endforeach()
set(SOLID_BUILD_JSON "{\"upstream_commit\":\"${SOLID_UPSTREAM_COMMIT}\",\"source_files\":{${SOLID_BUILD_FILES_JSON}}}")
configure_file(cmake/build_info.hpp.in generated/solid_build_info.hpp @ONLY)
